<Project>
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Messaging.Abstractions' Or '$(MSBuildProjectName)' == 'Messaging.RabbitMQ' Or '$(MSBuildProjectName)' == 'Messaging.Idempotency.Redis' Or '$(MSBuildProjectName)' == 'Messaging.Idempotency.PostgreSql' Or '$(MSBuildProjectName)' == 'Messaging.Idempotency.Sqlite' Or '$(MSBuildProjectName)' == 'Messaging.Outbox.PostgreSql' Or '$(MSBuildProjectName)' == 'Messaging.Management'">
    <IsPackable>true</IsPackable>
    <PackageId>$(MSBuildProjectName.Replace('Messaging.', 'CourierLane.'))</PackageId>
    <Description>CourierLane messaging components for .NET 10 and RabbitMQ AMQP 1.0.</Description>
    <PackageTags>dotnet;messaging;rabbitmq;amqp</PackageTags>
    <RepositoryUrl>https://github.com/nlyutakov/messaging</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
